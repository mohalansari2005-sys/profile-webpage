DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# One provider: generation and embeddings both.
OPENAI_API_KEY=your-openai-platform-key
# Defaults live in config/settings.py. Leave these commented out unless
# overriding on purpose: a pinned name is how a retired model (gpt-4.1-nano,
# shut down 2026-10-23) stayed in use after the code's default had moved on.
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_FAST_MODEL=gpt-4.1-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/0

IP_HASH_SALT=replace-me-with-a-long-random-string
CHAT_RATE=10/min
CHAT_DAILY_CAP=200
CORS_ORIGINS=http://localhost:3000
