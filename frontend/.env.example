# The chat backend's endpoint. A URL, safe to inline into the bundle — unlike
# anything in backend/.env, none of which may ever appear here.
# Production sets it in Vercel (DEPLOYMENT.md, step 7). Unset, the Ask section
# is not rendered.
# Local: copy this file to .env.local with the compose stack's address.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000/api/chat/
